# =========================================================================
# Nexus — environment configuration TEMPLATE
# Copy to api.env and fill in real values:   cp api.env.example api.env
# api.env is git-ignored; never commit real secrets.
# =========================================================================

# --- Freshservice ---------------------------------------------------------
# Subdomain only (e.g. "acmehelpdesk") or full host ("acmehelpdesk.freshservice.com").
FRESHSERVICE_DOMAIN=your-subdomain
# Optional custom portal host used for ticket deep links (e.g. helpdesk.acme.com).
# FRESHSERVICE_PORTAL_DOMAIN=helpdesk.example.com
FRESHSERVICE_API_KEY=your-freshservice-api-key
# Optional override for ticket deep-link format.
# FRESHSERVICE_TICKET_URL_TEMPLATE=https://{domain}/a/tickets/{ticket_id}
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_SLEEP_SECONDS=60

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Default model for AI guidance + summaries (user can override per-session in the UI).
OPENAI_GUIDANCE_MODEL=gpt-4o-mini
# Defaults to OPENAI_GUIDANCE_MODEL when unset.
# OPENAI_SUMMARIZER_MODEL=gpt-4o-mini
# Comma-separated list of models offered in the in-app model picker.
# OPENAI_AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini

# --- ChromaDB -------------------------------------------------------------
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=nexus_tickets
# Silence noisy PostHog telemetry warnings.
CHROMA_TELEMETRY_IMPLEMENTATION=disabled

# --- Ingestion knobs ------------------------------------------------------
INGEST_STATUS_CODE=5          # 5 = Closed
INGEST_MAX_TOKENS=3000
INCLUDE_CONVERSATIONS_IN_EMBED=0
ENABLE_DESCRIPTION_CLEANING=1
# INGEST_SINCE_DAYS=7         # only ingest tickets updated in the last N days

# --- Search knobs ---------------------------------------------------------
SEARCH_MAX_DISTANCE=0.55
SEARCH_MAX_DISPLAY=10
USE_AI_SUMMARY=0
MAX_SIMILAR_TICKETS=5

# --- Debugging ------------------------------------------------------------
# LOG_GUIDANCE_PROMPT=1       # write AI guidance prompts to freshservice_debug.log
